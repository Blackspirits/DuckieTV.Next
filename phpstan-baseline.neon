		-
			message: '#^Instanceof between Illuminate\\Http\\Client\\Response and Illuminate\\Http\\Client\\Response will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: app/Services/TorrentSearchEngines/GenericSearchEngine.php

		-
			message: '#^Instanceof between Illuminate\\Http\\Client\\Response and Illuminate\\Http\\Client\\Response will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: app/Services/WatchlistService.php

		-
			message: '#^Match expression does not handle remaining value\: non\-empty\-string$#'
			identifier: match.unhandled
			count: 1
			path: app/Support/TorrentSize.php
