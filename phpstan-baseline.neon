			path: app/DTOs/TorrentData/KtorrentData.php

		-
			message: '#^Parameter \#1 \$startYear of method App\\Services\\CalendarService\:\:getEpisodeCountsByYear\(\) expects int, float given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/CalendarController.php

		-
			message: '#^Parameter \#2 \$endYear of method App\\Services\\CalendarService\:\:getEpisodeCountsByYear\(\) expects int, float given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/CalendarController.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$id\.$#'
			identifier: property.notFound
			count: 1
			path: app/Jobs/TraktUpdateJob.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$lastupdated\.$#'
			identifier: property.notFound
