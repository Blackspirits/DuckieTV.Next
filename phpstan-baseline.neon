		-
			message: '#^Property App\\Services\\AutoDownloadService\:\:\$remoteTorrents has unknown class App\\DTOs\\TorrentData\\TorrentDataInterface as its type\.$#'
			identifier: class.notFound
			count: 1
			path: app/Services/AutoDownloadService.php

		-
			message: '#^Strict comparison using \=\=\= between true and false will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 3
			path: app/Services/AutoDownloadService.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 2
			path: app/Services/CalendarService.php

		-
			message: '#^Offset ''rating'' on non\-empty\-array on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 2
			path: app/Services/FavoritesService.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 2
			path: app/Services/SubtitlesService.php

		-
			message: '#^Negated boolean expression is always false\.$#'
			identifier: booleanNot.alwaysFalse
			count: 1
			path: app/Services/SubtitlesService.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: app/Services/TorrentClients/DelugeClient.php

		-
			message: '#^Call to an undefined method Illuminate\\Http\\Client\\PendingRequest\:\:data\(\)\.$#'
