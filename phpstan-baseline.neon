		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$trakt_id\.$#'
			identifier: property.notFound
			count: 2
			path: app/Jobs/TraktUpdateJob.php

		-
			message: '#^Loose comparison using \!\= between int\<min, \-1\>\|int\<1, max\> and 0 will always evaluate to true\.$#'
			identifier: notEqual.alwaysTrue
			count: 1
			path: app/Models/Episode.php

		-
			message: '#^Loose comparison using \=\= between int\<min, \-1\>\|int\<1, max\> and 0 will always evaluate to false\.$#'
			identifier: equal.alwaysFalse
			count: 2
			path: app/Models/Episode.php

		-
			message: '#^Parameter \#1 \$string of function str_pad expects string, int given\.$#'
			identifier: argument.type
			count: 3
			path: app/Models/Episode.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Support\\Collection\<int,Illuminate\\Database\\Eloquent\\Model\>\:\:each\(\) expects callable\(Illuminate\\Database\\Eloquent\\Model, int\)\: mixed, Closure\(App\\Models\\Episode\)\: App\\Models\\Episode given\.$#'
			identifier: argument.type
			count: 2
			path: app/Models/Season.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Support\\Collection\<int,Illuminate\\Database\\Eloquent\\Model\>\:\:filter\(\) expects \(callable\(Illuminate\\Database\\Eloquent\\Model, int\)\: bool\)\|null, Closure\(App\\Models\\Episode\)\: bool given\.$#'
			identifier: argument.type
			count: 1
			path: app/Models/Season.php

		-
			message: '#^Method App\\Models\\Serie\:\:getEpisodesMap\(\) should return array\<int, App\\Models\\Episode\> but returns array\<Illuminate\\Database\\Eloquent\\Model\>\.$#'
			identifier: return.type
			count: 1
			path: app/Models/Serie.php

		-
			message: '#^Method App\\Models\\Serie\:\:getLastEpisode\(\) should return App\\Models\\Episode\|null but returns Illuminate\\Database\\Eloquent\\Model\|null\.$#'
			identifier: return.type
			count: 1
			path: app/Models/Serie.php

		-
			message: '#^Method App\\Models\\Serie\:\:getLatestSeason\(\) should return App\\Models\\Season\|null but returns Illuminate\\Database\\Eloquent\\Model\|null\.$#'
			identifier: return.type
			count: 1
			path: app/Models/Serie.php

		-
			message: '#^Method App\\Models\\Serie\:\:getNextEpisode\(\) should return App\\Models\\Episode\|null but returns Illuminate\\Database\\Eloquent\\Model\|null\.$#'
			identifier: return.type
			count: 1
			path: app/Models/Serie.php

		-
			message: '#^Method App\\Models\\Serie\:\:getSeasonsByNumber\(\) should return array\<int, App\\Models\\Season\> but returns array\<Illuminate\\Database\\Eloquent\\Model\>\.$#'
			identifier: return.type
			count: 1
			path: app/Models/Serie.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Support\\Collection\<int,Illuminate\\Database\\Eloquent\\Model\>\:\:each\(\) expects callable\(Illuminate\\Database\\Eloquent\\Model, int\)\: mixed, Closure\(App\\Models\\Episode\)\: App\\Models\\Episode given\.$#'
			identifier: argument.type
			count: 3
			path: app/Models/Serie.php

		-
			message: '#^Negated boolean expression is always false\.$#'
